<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/btnPickApks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Pilih APK (bisa lebih dari satu)" />

        <TextView
            android:id="@+id/txtApkCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Belum ada APK dipilih" />

        <Button
            android:id="@+id/btnPickIcon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="2. Pilih Ikon Baru (PNG, opsional)" />

        <TextView
            android:id="@+id/txtIcon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belum ada ikon dipilih" />

        <EditText
            android:id="@+id/editAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Nama aplikasi baru (opsional)" />

        <EditText
            android:id="@+id/editFindText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Cari teks di dalam file assets (opsional)" />

        <EditText
            android:id="@+id/editReplaceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ganti dengan teks (opsional)" />

        <Button
            android:id="@+id/btnProcess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="3. Proses &amp; Sign Semua APK" />

        <TextView
            android:id="@+id/txtLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:text="Log akan muncul di sini." />

    </LinearLayout>
</ScrollView>
